<!-- ===== Terminal window ===== -->
<g>
    <!-- Subtle drop shadow -->
    <rect x="291" y="251" width="700" height="58" rx="8" ry="8" fill="#000000" opacity="0.55"/>

    <!-- Terminal body -->
    <rect x="290" y="250" width="700" height="58" rx="8" ry="8" fill="#1e1e1e" stroke="#3a3a3a" stroke-width="1"/>

    <!-- Title bar -->
    <rect x="290" y="250" width="700" height="20" rx="8" ry="8" fill="#2d2d2d"/>
    <rect x="290" y="262" width="700" height="8" fill="#2d2d2d"/>
    <line x1="290" y1="270" x2="990" y2="270" stroke="#3a3a3a" stroke-width="1"/>

    <!-- macOS-style buttons -->
    <circle cx="304" cy="260" r="5" fill="#ff5f57" stroke="#e0443e" stroke-width="0.5"/>
    <circle cx="320" cy="260" r="5" fill="#febc2e" stroke="#dea123" stroke-width="0.5"/>
    <circle cx="336" cy="260" r="5" fill="#28c840" stroke="#1aab29" stroke-width="0.5"/>

    <!-- Title bar text -->
    <text x="640" y="265" fill="#b0b0b0" font-family="'SF Mono', 'Menlo', 'Courier New', monospace" font-size="11" text-anchor="middle">
        ben@chile: ~
    </text>

    <!-- Prompt and command -->
    <g font-family="'SF Mono', 'Menlo', 'Consolas', 'Courier New', monospace" font-size="14">
        <!-- user@host -->
        <text x="305" y="294" fill="#00f900" font-weight="bold">ben@chile</text>
        <text x="383" y="294" fill="#e0e0e0">:</text>
        <text x="389" y="294" fill="#448aff" font-weight="bold">~</text>
        <text x="399" y="294" fill="#e0e0e0">$</text>

        <!-- Command typed (revealed by mask) -->
        <text x="412" y="294" fill="#f4f2ed"></text>
        <text x="412" y="294" fill="#b1dd8c"> Benjamin Aliaga - Computer Engineering student</text>

        <!-- Mask: black rect that retracts to reveal text -->
        <rect x="412" y="278" width="525" height="20" fill="#1e1e1e">
            <animate attributeName="x"
                     values="412;937;937;412"
                     keyTimes="0;0.55;0.95;1"
                     dur="6s"
                     repeatCount="indefinite"/>
            <animate attributeName="width"
                     values="525;0;0;525"
                     keyTimes="0;0.55;0.95;1"
                     dur="6s"
                     repeatCount="indefinite"/>
        </rect>

        <!-- Block cursor -->
        <rect y="280" width="8" height="16" fill="#00f900">
            <animate attributeName="x"
                     values="412;937;937;412"
                     keyTimes="0;0.55;0.95;1"
                     dur="6s"
                     repeatCount="indefinite"/>
            <animate attributeName="opacity"
                     values="1;1;0;1;0;1"
                     keyTimes="0;0.5;0.6;0.7;0.8;1"
                     dur="1s"
                     repeatCount="indefinite"/>
        </rect>
    </g>
</g>
    
</svg>
