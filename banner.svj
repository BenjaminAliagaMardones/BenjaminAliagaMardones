    <image
            href="data:image/gif;base64,"
            x="565" y="85"
            width="150" height="150"
            clip-path="url(#avatarClip)"
            preserveAspectRatio="xMidYMid slice" />

    <circle cx="640" cy="160" r="75"
            fill="none"
            stroke="url(#glowGrad)"
            stroke-width="3"
            filter="url(#glow)">
        <animate attributeName="r"
                 values="70;80;70"
                 dur="2.5s"
                 repeatCount="indefinite"/>
        <animate attributeName="opacity"
                 values="0.6;1;0.6"
                 dur="2.5s"
                 repeatCount="indefinite"/>
    </circle>

    <g transform="translate(640 160)">
        <circle cx="0" cy="0" r="90"
                fill="none"
                stroke="url(#glowGrad)"
                stroke-width="2"
                stroke-dasharray="6 4"
                filter="url(#glow)">
            <animateTransform
                    attributeName="transform"
                    type="rotate"
                    from="0"
                    to="360"
                    dur="10s"
                    repeatCount="indefinite"/>
        </circle>
    </g>

    <!-- Floating particles -->
    <g fill="#00f900" opacity="0.8">
        
        <circle cx="128" cy="256" r="2">
            <animate attributeName="cy" values="256;64" dur="5s" repeatCount="indefinite"/>
