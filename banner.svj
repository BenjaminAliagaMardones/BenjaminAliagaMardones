<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 1280 320"
     width="1280"
     height="400"
     style="background:#000000">

    <defs>
        <!-- Glow -->
        <filter id="glow">
            <feGaussianBlur stdDeviation="4" result="blur"/>
            <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
            </feMerge>
        </filter>

        <!-- Stronger glow for meteors -->
        <filter id="meteorGlow">
            <feGaussianBlur stdDeviation="3" result="blur"/>
            <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
            </feMerge>
        </filter>

        <!-- Gradient for waves -->
        <linearGradient id="waveGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#00f900"/>
            <stop offset="50%" stop-color="#263e0f"/>
            <stop offset="100%" stop-color="#b1dd8c"/>
        </linearGradient>

        <!-- Gradient for glowing circle -->
        <linearGradient id="glowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#00f900"/>
            <stop offset="50%" stop-color="#000000"/>
            <stop offset="100%" stop-color="#00f900"/>
        </linearGradient>

        <!-- Meteor trail gradients -->
        
        <linearGradient id="trail-1777829154239" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0288d1" stop-opacity="0"/>
            <stop offset="100%" stop-color="#0288d1" stop-opacity="1"/>
        </linearGradient>

        <linearGradient id="trail-1777829325657" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0f0f0f" stop-opacity="0"/>
            <stop offset="100%" stop-color="#0f0f0f" stop-opacity="1"/>
        </linearGradient>

        <linearGradient id="trail-1777835255846" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#e64a19" stop-opacity="0"/>
            <stop offset="100%" stop-color="#e64a19" stop-opacity="1"/>
        </linearGradient>

        <linearGradient id="trail-1777835331962" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#2f3a3e" stop-opacity="0"/>
            <stop offset="100%" stop-color="#2f3a3e" stop-opacity="1"/>
        </linearGradient>

        <linearGradient id="trail-1777835423064" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#f4f2ed" stop-opacity="0"/>
            <stop offset="100%" stop-color="#f4f2ed" stop-opacity="1"/>
        </linearGradient>

        <linearGradient id="trail-1777835518245" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0288d1" stop-opacity="0"/>
            <stop offset="100%" stop-color="#0288d1" stop-opacity="1"/>
        </linearGradient>

        <linearGradient id="trail-1777835586861" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#191919" stop-opacity="0"/>
            <stop offset="100%" stop-color="#191919" stop-opacity="1"/>
        </linearGradient>

        <linearGradient id="trail-1777835635261" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#5c4ee5" stop-opacity="0"/>
            <stop offset="100%" stop-color="#5c4ee5" stop-opacity="1"/>
        </linearGradient>

        <linearGradient id="trail-1777835690277" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#336791" stop-opacity="0"/>
            <stop offset="100%" stop-color="#336791" stop-opacity="1"/>
        </linearGradient>

        <linearGradient id="trail-1777835725398" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#448aff" stop-opacity="0"/>
            <stop offset="100%" stop-color="#448aff" stop-opacity="1"/>
        </linearGradient>

        <linearGradient id="trail-1777835794728" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#252f3e" stop-opacity="0"/>
            <stop offset="100%" stop-color="#252f3e" stop-opacity="1"/>
        </linearGradient>

        <!-- Circle clip for avatar -->
        <clipPath id="avatarClip">
            <circle cx="640" cy="160" r="75"/>
        </clipPath>
    </defs>

    <!-- Background waves -->
    <path d="M0 160 Q160 128 320 160 T640 160 T960 160 T1280 160"
          fill="none"
          stroke="url(#waveGrad)"
          stroke-width="2"
          opacity="0.5">
        <animate attributeName="d"
                 dur="6s"
                 repeatCount="indefinite"
                 values="
             M0 160 Q160 128 320 160 T640 160 T960 160 T1280 160;
             M0 160 Q160 192 320 160 T640 160 T960 160 T1280 160;
             M0 160 Q160 128 320 160 T640 160 T960 160 T1280 160"/>
    </path>

    <!-- ========== METEOR LOGOS ========== -->
    
            <!-- material-icon-theme:python Meteor -->
